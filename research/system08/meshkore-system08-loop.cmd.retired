@echo off
REM Keep the System 08 experiment loop alive. No privileges, no service, no elevation.
REM
REM WHY: the operator's instruction is that continuous improvement runs twenty-four hours a
REM day whether or not anyone is watching. Until now the loop was started from an agent
REM session and died with it, which means "continuous" lasted exactly as long as someone was
REM at the keyboard. The listener learned this lesson the expensive way - it died on
REM 2026-09-11 and was not noticed for two days.
REM
REM Scheduled Task registration is refused without elevation on this machine (access denied
REM from both schtasks and Register-ScheduledTask), so the per-user Startup folder plus this
REM relaunch-on-exit wrapper is the path that actually works. REPO is written as an absolute
REM path at install time, because %~dp0 points at the Startup folder once copied there.
setlocal
set REPO=C:\Users\Workstation\Documents\Prj\asimovia\meshkore-crypto-cluster
set PYTHONPATH=%REPO%\trading-system
set PYTHONIOENCODING=utf-8
cd /d "%REPO%"
:loop
python -u research\system08\loop.py >> research\system08\loop.out 2>&1
REM A clean exit is still an exit: this loop is never supposed to finish.
timeout /t 15 /nobreak >nul
goto loop
