  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "research_mode": {"type": "string"},
    "family": {"type": "string"},
    "economic_or_behavioral_story": {"type": "string"},
    "market_mechanism": {"type": "string"},
    "data_required": {"type": "array", "items": {"type": "string"}},
    "features": {"type": "array", "items": {"type": "string"}},
    "trigger": {"type": "string"},
    "market_context": {"type": "string"},
    "regime": {"type": "string"},
    "entry_logic": {"type": "string"},
    "exit_logic": {"type": "string"},
    "invalidators": {"type": "array", "items": {"type": "string"}},
