# Who the loop is, and where it works. Sourced by every bin/ script.
# No secrets here: the public cluster admits agents tokenless, and this file is
# the reason nothing under bin/ ever needs to open .meshkore/credentials/.

# The loop lives inside the repository it drives, so REPO is derived rather
# than hard-coded: bin/ -> loop/ -> orchestrator-manager/ -> repo root.
REPO=$(cd "$HERE/../.." && pwd)
BRANCH=regime-aware-system

# Public cluster "Open Crypto Algo Agents Development" (.meshkore/public/cluster.yaml)
CLUSTER_ID=c_6d80584497f943d29026

# Mac-native agent identities carry the blackmac- prefix.
AGENT_HANDLE=blackmac-quantlab-loop
