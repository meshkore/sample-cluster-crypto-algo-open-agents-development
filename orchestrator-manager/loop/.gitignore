# Raw iteration output. Large, machine-specific, and it quotes absolute paths
# into the operator's runtime data directory. The ledger is the durable record;
# these logs are the working notes behind it.
runs/

# Untrusted third-party text from the Wall. Kept on disk so a claim can be
# traced back to what was actually said, never committed and never treated as
# instructions.
cluster/inbox/

# The lock is live state for exactly one machine.
ledger/iteration.lock

__pycache__/
*.pyc
.DS_Store

# The readable diary. Wholly derived from the tracked ledger plus the untracked
# journals, rewritten in full after every iteration, so committing it would put
# a hundred-file diff in history to say the counter moved. `quantlab diary`
# rebuilds it on any machine that has the ledger.
diary/

# The intraday loop's iteration counter, rewritten every iteration and holding
# nothing the ledger does not already hold. `ledger.jsonl` beside it IS tracked:
# it is the loop's memory, and a memory that does not travel with the repository
# is one every checkout has to rediscover.
intraday/state.json
